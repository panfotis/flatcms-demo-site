APP_ENV=dev
# Required in production — every absolute URL the site publishes is built from
# it: sitemap <loc>, canonical, og:image. Left commented locally, where
# config.php falls back to DDEV_PRIMARY_URL and is therefore always right.
#SITE_BASE_URL=https://example-domain.com
AUTH_MODE=cf_access
AUTH_DEV_BYPASS=0
CF_ACCESS_TEAM_DOMAIN=change-me.cloudflareaccess.com
CF_ACCESS_AUD=
ADMIN_LOCALE=en
FORM_TO=
FORM_FROM=
MAIL_DSN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional: upload ceilings, in bytes. Defaults are 12 MB for images and 10 MB
# for video. Keep them below the web server's body limit (16 MB in
# nginx.conf.example / apache.conf.example) — the smallest of the three wins.
#IMAGE_MAX_UPLOAD=12582912
#VIDEO_MAX_UPLOAD=10485760

# ─── Server only ────────────────────────────────────────────────────────────
# Everything below is for the deployed site and stays commented out locally,
# where DDEV supplies its own values.
#
# The panel writes pages here, so it must sit OUTSIDE the git checkout — or
# every `git pull` collides with edits made in /admin.php. ROLES_FILE moves for
# the same reason plus one more: config/roles.yml is committed, and real
# addresses do not belong in a repository.
#CONTENT_PATH=/srv/dopamine-flatcms-demo-content
#ROLES_FILE=/srv/dopamine-flatcms-demo-content/roles.yml

# R2. With this off, uploads land in CONTENT_PATH/uploads and are served by the
# nginx /uploads/ alias. With it on, new uploads get absolute bucket URLs —
# but keep that alias anyway, for every image saved before the switch.
# media_bases needs no edit: config.php appends R2_PUBLIC_BASE automatically.
#R2_ENABLED=1
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_BASE=https://media.dopamine-flatcms-demo.fotispan.gr

# Purge the edge on save. Token needs Zone → Cache Purge → Purge.
#CF_PURGE_ENABLED=1
#CF_ZONE_ID=
#CF_API_TOKEN=
