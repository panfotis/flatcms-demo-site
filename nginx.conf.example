# The nginx virtual host for dopamine-flatcms-demo.fotispan.gr — nothing in the
# CMS reads this file. Copy it to /etc/nginx/sites-available/, symlink it into
# sites-enabled/, and check the php-fpm socket path matches this box. DDEV
# writes its own vhost, so this is only for the server.
server {
    listen 443 ssl http2;
    server_name dopamine-flatcms-demo.fotispan.gr;

    # No `current` symlink: this site deploys with `git pull`, not with the
    # atomic-release layout. content/, vendor/ and config.php sit above the
    # public/ docroot and are never reachable over HTTP.
    root /var/www/dopamine-flatcms-demo/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/dopamine-flatcms-demo.fotispan.gr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dopamine-flatcms-demo.fotispan.gr/privkey.pem;

    # The real visitor address, and the reason the contact form's rate limiter
    # works at all. Behind Cloudflare every request arrives from Cloudflare, so
    # a per-IP counter keyed on REMOTE_ADDR rate-limits the entire internet as
    # one bucket — five submissions a day for everybody, worldwide.
    #
    # This is the right place for it rather than PHP reading the header: nginx
    # checks *who it is talking to* before believing CF-Connecting-IP, so the
    # header cannot be forged by anyone reaching the origin directly. PHP then
    # sees a REMOTE_ADDR that is already correct and trusts nothing.
    #
    # Create it before the first `nginx -t`, or the include fails and nginx
    # refuses to start. Refresh from a cron — the ranges change, and a stale
    # list silently reverts you to one bucket:
    #   curl -s https://www.cloudflare.com/ips-v4 https://www.cloudflare.com/ips-v6 \
    #     | sed 's/^/set_real_ip_from /; s/$/;/' > /etc/nginx/cloudflare-ips.conf
    include /etc/nginx/cloudflare-ips.conf;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    # Pretty URLs: every path that is not a real file goes to index.php,
    # which resolves it against content/pages/<locale>/*.yml by slug.
    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    # The admin panel. Cloudflare Access sits in front of this path; PHP
    # verifies the Access JWT so the origin cannot be hit directly.
    location = /admin.php {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;

        # Never let the panel be cached anywhere.
        add_header Cache-Control "no-store, private" always;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    # CONTENT_PATH, not the checkout: the panel writes here, and it must survive
    # every `git pull`. An alias rather than a symlink, so nothing inside public/
    # points outside it, and stored `src` values stay `/uploads/...` either way.
    #
    # Keep this even with R2_ENABLED=1. New uploads get absolute R2 URLs and
    # never reach this server, but every image saved before R2 was switched on
    # is still referenced as /uploads/... — drop this block and the demo 404s
    # its own pictures.
    location /uploads/ {
        alias /srv/dopamine-flatcms-demo-content/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        # Uploaded files are never executed, whatever their extension. This is
        # the reason the directory must not be reachable by any other path.
        location ~ \.php$ { return 403; }
    }

    # Belt and braces: block dotfiles and any stray YAML under the docroot.
    location ~ /\.        { deny all; }
    location ~ \.ya?ml$   { deny all; }

    client_max_body_size 16m;
}

server {
    listen 80;
    server_name dopamine-flatcms-demo.fotispan.gr;
    return 301 https://$host$request_uri;
}
